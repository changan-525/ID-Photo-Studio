{
  "name": "id-photo-studio",
  "version": "1.0.0",
  "private": true,
  "description": "拾像 — privacy-first, in-browser ID photo editor",
  "author": "ID Photo Studio contributors",
  "main": "electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "predev": "npm run setup:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run setup:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win portable --x64",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "generate:icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.changan525.idphotostudio",
    "productName": "ID Photo Studio",
    "copyright": "Copyright © 2026 ID Photo Studio contributors",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release/portable"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ID-Photo-Studio-Windows-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
